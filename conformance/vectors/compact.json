{
  "wolsVersion": "1.5.0-rc.2",
  "description": "Compact URL parsing, parameter registry and species codes",
  "specSection": "QR Code Encoding > Compact Format (Compact URL rules; Species Code Registry)",
  "speciesCodes": {
    "POSTR": "Pleurotus ostreatus",
    "PCITRI": "Pleurotus citrinopileatus",
    "PDJAR": "Pleurotus djamor",
