          "payload": "AAAAAAAAAAAAAAAAAAAAAA",
          "iv": "AAAAAAAAAAAAAAAA",
          "kdf": "raw"
        },
        "organization": {
          "encrypted": true,
          "algorithm": "AES-256-GCM",
          "payload": "AAAAAAAAAAAAAAAAAAAAAA",
          "iv": "AAAAAAAAAAAAAAAA",
          "kdf": "raw"
        },
        "custom": {
          "encrypted": true,
          "algorithm": "AES-256-GCM",
          "payload": "AAAAAAAAAAAAAAAAAAAAAA",
          "iv": "AAAAAAAAAAAAAAAA",
          "kdf": "raw"
        },
        "lot": {
          "encrypted": true,
