          "clonalGeneration": 2,
          "transferDepth": 4,
          "lineage": "wemush:01JC8Z3K7Q0GS0000000000001"
        },
        "derivedFrom": [
          {
            "id": "wemush:01JC8Z3K7Q0GS0000000000001",
            "relation": "COMBINED",
            "quantity": {
              "value": 500,
              "unit": "g"
            }
          },
          {
            "id": "wemush:01JC8Z3K7Q0GS0000000000002",
            "relation": "COMBINED",
            "quantity": {
              "value": 500,
              "unit": "g"
            }
          }
        ]
      },
      "expected": {
        "valid": true
      }
