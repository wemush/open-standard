        "strain": {
          "name": "Blue Oyster",
          "generation": "F1"
        }
      },
      "expected": {
        "valid": true
      }
    },
    {
      "id": "generation-notation-g2",
      "operation": "validate",
      "requirement": "MUST",
      "description": "Generation notation `G2` is accepted",
      "input": {
        "@context": "https://wemush.com/wols/v1",
        "@type": "Specimen",
        "id": "wemush:clx1a2b3c4",
        "version": "1.3.0",
        "type": "SUBSTRATE",
        "species": "Pleurotus ostreatus",
        "strain": {
          "name": "Blue Oyster",
          "generation": "G2"
        }
      },
      "expected": {
        "valid": true
      }
    },
    {
      "id": "generation-notation-3",
      "operation": "validate",
      "requirement": "MUST",
      "description": "Generation notation `3` is accepted",
      "input": {
        "@context": "https://wemush.com/wols/v1",
        "@type": "Specimen",
        "id": "wemush:clx1a2b3c4",
        "version": "1.3.0",
        "type": "SUBSTRATE",
        "species": "Pleurotus ostreatus",
        "strain": {
          "name": "Blue Oyster",
          "generation": "3"
        }
      },
      "expected": {
        "valid": true
      }
    }
  ]
