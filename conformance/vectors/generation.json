        "strain": {
          "name": "Blue Oyster",
          "generation": "P"
        }
      },
      "expected": {
        "valid": true
      }
    },
    {
      "id": "generation-notation-f1",
      "operation": "validate",
      "requirement": "MUST",
      "description": "Generation notation `F1` is accepted",
      "input": {
