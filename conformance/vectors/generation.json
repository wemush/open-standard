{
  "wolsVersion": "1.3.0",
  "description": "Generation, subculture, and transfer depth",
  "specSection": "Generation, Subculture, and Transfer Tracking",
  "cases": [
    {
      "id": "transfer-depth-zero",
      "operation": "validate",
      "requirement": "MUST",
      "description": "Original culture has transferDepth 0",
      "input": {
        "@context": "https://wemush.com/wols/v1",
        "@type": "Specimen",
        "id": "wemush:clx1a2b3c4",
        "version": "1.3.0",
        "type": "SUBSTRATE",
        "species": "Pleurotus ostreatus",
        "strain": {
          "name": "Blue Oyster",
          "generation": "P",
          "clonalGeneration": 0,
          "transferDepth": 0
        }
      },
      "expected": {
        "valid": true
      }
    },
    {
      "id": "transfer-depth-example",
      "operation": "validate",
      "requirement": "MUST",
      "description": "Spec example: F1, third subculture, two expansion transfers",
      "input": {
        "@context": "https://wemush.com/wols/v1",
        "@type": "Specimen",
        "id": "wemush:clx1a2b3c4",
        "version": "1.3.0",
        "type": "SUBSTRATE",
        "species": "Pleurotus ostreatus",
        "strain": {
          "name": "Blue Oyster",
          "generation": "F1",
          "clonalGeneration": 3,
          "transferDepth": 5
        }
      },
      "expected": {
        "valid": true
      }
    },
    {
      "id": "transfer-depth-negative",
      "operation": "validate",
      "requirement": "MUST",
      "description": "transferDepth MUST be a non-negative integer",
      "input": {
        "@context": "https://wemush.com/wols/v1",
        "@type": "Specimen",
        "id": "wemush:clx1a2b3c4",
        "version": "1.3.0",
        "type": "SUBSTRATE",
        "species": "Pleurotus ostreatus",
        "strain": {
          "name": "Blue Oyster",
          "transferDepth": -1
        }
      },
      "expected": {
        "valid": false,
        "errorField": "strain.transferDepth"
      }
    },
    {
      "id": "transfer-depth-fraction",
      "operation": "validate",
      "requirement": "MUST",
      "description": "transferDepth MUST be an integer",
      "input": {
        "@context": "https://wemush.com/wols/v1",
        "@type": "Specimen",
        "id": "wemush:clx1a2b3c4",
        "version": "1.3.0",
        "type": "SUBSTRATE",
        "species": "Pleurotus ostreatus",
        "strain": {
          "name": "Blue Oyster",
          "transferDepth": 1.5
        }
      },
      "expected": {
        "valid": false,
        "errorField": "strain.transferDepth"
      }
    },
    {
      "id": "transfer-depth-string",
      "operation": "validate",
      "requirement": "MUST",
      "description": "transferDepth MUST be a number, not a string",
      "input": {
        "@context": "https://wemush.com/wols/v1",
        "@type": "Specimen",
        "id": "wemush:clx1a2b3c4",
        "version": "1.3.0",
        "type": "SUBSTRATE",
        "species": "Pleurotus ostreatus",
        "strain": {
          "name": "Blue Oyster",
          "transferDepth": "3"
        }
      },
      "expected": {
        "valid": false,
        "errorField": "strain.transferDepth"
      }
    },
    {
      "id": "transfer-depth-below-clonal",
      "operation": "validate",
      "requirement": "SHOULD",
      "description": "transferDepth SHOULD be >= clonalGeneration; a lower value is valid but warns",
      "input": {
        "@context": "https://wemush.com/wols/v1",
        "@type": "Specimen",
        "id": "wemush:clx1a2b3c4",
        "version": "1.3.0",
        "type": "SUBSTRATE",
        "species": "Pleurotus ostreatus",
        "strain": {
          "name": "Blue Oyster",
          "clonalGeneration": 3,
          "transferDepth": 1
        }
      },
      "expected": {
        "valid": true,
        "warningField": "strain.transferDepth"
      }
    },
    {
      "id": "generation-notation-p",
      "operation": "validate",
      "requirement": "MUST",
      "description": "Generation notation `P` is accepted",
      "input": {
        "@context": "https://wemush.com/wols/v1",
        "@type": "Specimen",
        "id": "wemush:clx1a2b3c4",
        "version": "1.3.0",
