  "cases": [
    {
      "id": "bundle-valid",
      "operation": "validateBundle",
      "requirement": "MUST",
      "description": "A small bundle with a strain, specimen, observation and harvest",
      "input": {
        "@context": "https://wemush.com/wols/v1",
        "@type": "Bundle",
        "version": "1.5.0-rc.1",
        "publisher": {
          "name": "Example Farm"
        },
        "license": "CC-BY-4.0",
        "strains": [
          {
            "id": "strain_po",
            "name": "Blue Oyster",
            "taxon": {
              "scientificName": "Pleurotus ostreatus"
            }
          }
        ],
        "specimens": [
          {
            "@context": "https://wemush.com/wols/v1",
            "@type": "Specimen",
            "id": "wemush:01JC8Z3K7Q0FB0000000000001",
            "version": "1.5.0-rc.1",
            "type": "FRUITING",
            "species": "Pleurotus ostreatus",
            "stage": "FRUITING",
            "strainRef": "strain_po",
            "substrateDryWeight": {
              "value": 1000,
              "unit": "g"
            }
          }
        ],
        "observations": [
          {
            "id": "obs_1",
            "specimen": "wemush:01JC8Z3K7Q0FB0000000000001",
            "observedAt": "2026-11-12T08:30:00Z",
            "kind": "ENVIRONMENT",
            "environment": {
              "temperature": {
                "value": 16.5,
                "unit": "Cel"
              }
            }
          }
        ],
        "harvests": [
          {
            "id": "hv_1",
            "specimen": "wemush:01JC8Z3K7Q0FB0000000000001",
            "harvestedAt": "2026-11-20T10:00:00Z",
            "flush": 1,
            "freshWeight": {
              "value": 612,
              "unit": "g"
            }
          }
        ]
      },
      "expected": {
        "valid": true
      }
    },
